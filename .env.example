# Скопируйте этот файл в .env и задайте свои значения:
#   cp .env.example .env
# Файл .env в git не попадает.

# --- PostgreSQL ---
POSTGRES_DB=boardgames
POSTGRES_USER=boardgames
POSTGRES_PASSWORD=change-me-db-password

# --- MinIO (хранилище логотипов, музыки, видео, инструкций) ---
MINIO_ROOT_USER=boardgames
# минимум 8 символов
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- Вход в админку (/admin/login) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Порты ---
# Порт, на котором сайт доступен снаружи
HTTP_PORT=80
# Консоль MinIO (слушает только 127.0.0.1 на сервере)
MINIO_CONSOLE_PORT=9001

# --- Необязательно ---
# Образ MinIO. Официальные minio/minio больше не публикуются, по умолчанию берётся
# сборка сообщества (см. docker-compose.yml и DEPLOY.md).
# MINIO_IMAGE=ghcr.io/coollabsio/minio:RELEASE.2025-10-15T17-29-55Z
